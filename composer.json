{
    "name": "zeggriim/youtrust-webhook-bundle",
    "description": "A Symfony bridge for handling YouTrust (formerly Yousign) webhooks via RemoteEvent.",
    "keywords": [
        "yousign",
        "youtrust",
        "webhook",
        "remote-event",
        "symfony",
        "bundle"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "psr/cache": "^2.0|^3.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/deprecation-contracts": "^2.5|^3.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/remote-event": "^6.4|^7.0|^8.0",
        "symfony/webhook": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.82",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.2",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Zeggriim\\YouTrustWebhookBundle\\": "src/",
            "Zeggriim\\YousignWebhookBundle\\": "src/Legacy/"
        },
        "files": [
            "src/Legacy/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zeggriim\\YouTrustWebhookBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Zeggriim",
            "email": "lilian.dorazio@hotmail.fr"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "replace": {
        "zeggriim/yousign-webhook-bundle": "self.version"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "homepage": "https://github.com/zeggriim2/youtrust-webhook",
    "support": {
        "issues": "https://github.com/zeggriim2/youtrust-webhook/issues",
        "source": "https://github.com/zeggriim2/youtrust-webhook"
    }
}
